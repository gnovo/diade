{
  "name": "diade-monorepo",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome check --write .",
    "prepare": "lefthook install",
    "i18n:check": "NODE_NO_WARNINGS=1 node scripts/check-i18n.mjs",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "knip": "^6.44.2",
    "lefthook": "2.2.2",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
