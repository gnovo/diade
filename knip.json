{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "neon.ts"]
    },
    "apps/api": {
      "entry": ["src/index.ts", "drizzle.config.ts", "src/**/*.test.ts"]
    },
    "apps/mobile": {
      "entry": ["index.js", "app.config.ts", "plugins/*", "src/**/*.test.{ts,tsx}"],
      "metro": false
    },
    "packages/*": {
      "entry": ["src/index.ts", "scripts/*", "src/**/*.test.ts"]
    }
  }
}
