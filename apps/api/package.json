{
  "name": "@diade/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true op run --env-file=.dev.vars.tpl -- wrangler dev",
    "dev:plain": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-cache",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "op run --env-file=.dev.vars.tpl -- drizzle-kit migrate",
    "db:studio": "op run --env-file=.dev.vars.tpl -- drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.19",
    "@diade/contracts": "workspace:*",
    "@diade/domain": "workspace:*",
    "@diade/validation": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/cloudflare": "^11.11.0",
    "better-auth": "^1.7.19",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@diade/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
