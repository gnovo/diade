# Environment
ENVIRONMENT=development

# Database (Neon PostgreSQL direct connection string for migrations & local dev)
DATABASE_URL=postgres://<username>:<password>@<neon-host>/<database>?sslmode=require

# Better Auth Configuration
BETTER_AUTH_SECRET=generate-a-random-32-char-secret-key-here
BETTER_AUTH_URL=http://localhost:8787

# Google OAuth Credentials (for Better Auth & Google Calendar)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Sentry Observability
SENTRY_DSN=https://your-dsn@sentry.io/project-id
