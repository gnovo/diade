{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diade-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "BETTER_AUTH_URL": "https://diade-api.diade.workers.dev"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
