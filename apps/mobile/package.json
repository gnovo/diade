    "android:dev": "bash scripts/run-android-dev.sh",
    "android:dev:local": "bash scripts/run-android-dev.sh --local",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:android:prod": "bash scripts/build-android-prod.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-cache",
    "release:ota": "bash scripts/release-android.sh ota",
    "release:apk": "bash scripts/release-android.sh apk",
    "fingerprint": "npx @expo/fingerprint fingerprint:generate --platform android"
