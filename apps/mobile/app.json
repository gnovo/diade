{
  "expo": {
    "name": "Díade",
    "slug": "diade",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "diade",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D4F46"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.diade.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0D4F46"
      },
      "package": "com.diade.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "organization": "diade",
          "project": "diade-mobile"
        }
      ],
      "./plugins/with-diade-icons",
      "./plugins/with-diade-release-signing"
    ]
  }
}
